        "name": "Support System",
        "description": "Notifies admins when a client joins the support channel."
      },
      "temp-channel-creator": {
        "name": "Temp Channel Creator",
        "description": "Creates a temporary channel when a client joins a lobby channel, then moves them in. Cleanup deletes only empty channels created and tracked by this flow; existing siblings are preserved."
      },
      "auto-rank": {
        "name": "Auto-Rank",
        "description": "Automatically assigns server groups based on cumulative online time."
      },
      "last-seen-tracker": {
        "name": "Last-Seen Tracker",
        "description": "Records the last-seen timestamp when a client disconnects."
      },
      "support-ticket": {
        "name": "Support Ticket",
        "description": "On !support <topic>, creates a tracked temporary channel, moves the user into it, and pokes a staff group. Empty tracked channels are removed by the existing cleanup."
      },
      "timed-reminder": {
        "name": "Timed Reminder",
        "description": "On !remind 10m <text>, privately messages the requester after that delay. Waits longer than 24 hours are capped so a run cannot wait for days."
      },
      "scheduled-announcement": {
        "name": "Scheduled Announcement",
        "description": "Posts a message to one channel or the whole server on a schedule. Use {{token}} where the date should appear."
      },
      "afk-mover": {
        "name": "AFK Mover",
        "description": "Moves idle clients to an AFK channel after a configurable timeout."
      },
      "idle-kicker": {
        "name": "Idle Kicker",
        "description": "Kicks clients that have been idle for too long."
      },
      "bad-name-checker": {
        "name": "Bad Name Checker",
        "description": "Kicks clients whose nickname contains forbidden words."
      },
      "group-protector": {
        "name": "Group Protector",
        "description": "Kicks clients who have a protected group but lack the required authorization group."
      },
      "webhook-server-message": {
        "name": "Webhook → Server Message",
        "description": "Receives a webhook POST and broadcasts the message to the TeamSpeak server. Great for monitoring alerts, CI/CD notifications, or Discord bridges."
      },
      "webhook-group-assign": {
        "name": "Webhook → Assign Group",
